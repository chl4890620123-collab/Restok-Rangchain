# Local development / mini-PC runtime example.
DB_NAME=restok_db
DB_USER=restok
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-root-password
JWT_SECRET=change-this-jwt-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# AI is optional. Without a Gemini key, inventory/lifecycle features still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_IMAGE_BYTES=10485760

# Google OAuth is optional. Leave the Spring profile empty for username/password login only.
SPRING_PROFILES_ACTIVE=
REACT_APP_GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public/browser origin used by CORS and OAuth redirect handling.
APP_CORS_ALLOWED_ORIGINS=http://localhost:18081

# Database charset conversion is intentionally opt-in because ALTER TABLE can lock large tables.
DB_CHARSET_MIGRATION_ENABLED=false

# Only the frontend is exposed to the host. Server/Caddy should proxy to this loopback port.
RESTOK_BIND_HOST=127.0.0.1
RESTOK_FRONTEND_PORT=18081
