# Database
DB_NAME=restock_db
DB_USERNAME=restok
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password
DB_PORT=3308

# JWT - change this value before any public deployment.
# Must be at least 32 bytes.
JWT_SECRET=change_me_to_a_long_random_secret_1234567890
JWT_EXPIRATION_MS=86400000

# Google OAuth (optional)
# Leave disabled for simple local username/password login.
SPRING_PROFILES_ACTIVE=
REACT_APP_GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# To enable Google OAuth, set:
# SPRING_PROFILES_ACTIVE=oauth
# REACT_APP_GOOGLE_OAUTH_ENABLED=true
# GOOGLE_CLIENT_ID=<your id>
# GOOGLE_CLIENT_SECRET=<your secret>

# Gemini - required only for receipt analysis and AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_IMAGE_BYTES=10485760
AI_PORT=8000

# Frontend public origin used by CORS/OAuth redirect
# Docker local: http://localhost
# React dev server: http://localhost:3000
# Production: https://restok.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost

# Published web port on the mini PC / Docker host
WEB_PORT=80
